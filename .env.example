# ===== Supabase =====
# ถ้าใช้ Supabase local:  รัน `supabase start` แล้วคัดลอกค่ามาใส่
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# service role key — ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น (LINE webhook) ห้าม expose ให้ browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== LINE Messaging API (MVP 3) =====
# สร้าง Provider + Messaging API channel ที่ https://developers.line.biz
# แล้วนำ Channel access token (long-lived) และ Channel secret มาใส่
# ตั้ง Webhook URL เป็น  https://<โดเมนของคุณ>/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===== LINE Login + LIFF (พอร์ทัลผู้เช่าใน LINE) =====
# ต้องสร้าง "LINE Login channel" แยกจาก Messaging API channel (ผูก OA เดียวกัน)
# LINE_LOGIN_CHANNEL_ID = Channel ID ของ LINE Login channel (ใช้ตรวจ ID token ฝั่ง server)
LINE_LOGIN_CHANNEL_ID=
# NEXT_PUBLIC_LIFF_ID = LIFF ID จากแท็บ LIFF (รูปแบบ 1234567890-xxxxxxxx)
# สร้าง LIFF app: Size = Full, Scopes = openid + profile, Endpoint URL = https://<โดเมนของคุณ>/liff
NEXT_PUBLIC_LIFF_ID=
# LIFF_SESSION_SECRET = กุญแจเซ็น session cookie ของพอร์ทัลผู้เช่า (สุ่มยาว ≥ 32 ตัว, เก็บลับ)
# จำเป็น (fail-closed): ไม่ตั้ง = ออก/อ่าน session ไม่ได้ = พอร์ทัลผู้เช่าใช้ไม่ได้
# สร้าง: openssl rand -hex 32
LIFF_SESSION_SECRET=

# Anthropic API (AI อ่านมิเตอร์ MVP 5) — ขอคีย์ที่ console.anthropic.com
ANTHROPIC_API_KEY=

# ===== SMS OTP (เปลี่ยน auth เป็นเบอร์+OTP) =====
# SEND_SMS_HOOK_SECRET = secret ของ Supabase "Send SMS" hook (รูปแบบ v1,whsec_...) — ต้องตรงกับที่ตั้งใน Supabase
SEND_SMS_HOOK_SECRET=
# ผู้ให้บริการ SMS ของคุณ (ปรับ lib/sms.ts ให้ตรง API)
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Chao-Dee

# ===== Subscription lifecycle =====
# CRON_SECRET = ป้องกัน /api/cron/subscriptions (Vercel cron ส่ง Authorization: Bearer <นี้>)
CRON_SECRET=
# PromptPay ของบริษัท (รับชำระค่าแพ็คเกจจากสมาชิก) — เบอร์/เลขบัตร
NEXT_PUBLIC_PLATFORM_PROMPTPAY=

# Sentry (error monitoring) — เว้นว่างไว้ได้ถ้ายังไม่ใช้ (ระบบจะไม่ส่ง error)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# สำหรับอัปโหลด source map ตอน build (ตั้งบน Vercel เท่านั้น ไม่บังคับ)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ตรวจสลิปอัตโนมัติ (EasySlip/SlipOK) — เว้นว่างได้ (เจ้าของระบบตรวจเอง)
SLIP_VERIFY_URL=
SLIP_VERIFY_KEY=

# ===== ข้อมูลบริษัท (พิมพ์บนใบเสร็จ/ใบกำกับภาษี) =====
# ทุกตัวมี fallback ในโค้ด (src/lib/company.ts) — ตั้ง env เมื่อต้องการทับค่า
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_NAME_EN=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_TAX_ID=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
# NEXT_PUBLIC_COMPANY_VAT = "1" ถ้าบริษัทจด VAT (แสดง VAT 7% ในเอกสาร) มิฉะนั้นเว้นว่าง
NEXT_PUBLIC_COMPANY_VAT=
# เลขทะเบียนพาณิชย์ (DBD) + ลิงก์ตรวจสอบ (เว้นว่างได้)
NEXT_PUBLIC_DBD_REG_NO=
NEXT_PUBLIC_DBD_VERIFY_URL=
# แบรนด์แม่ที่แสดงบางหน้า — เว้นว่างได้
NEXT_PUBLIC_PARENT_BRAND=

# ===== เว็บไซต์ / ช่องทางช่วยเหลือ =====
# NEXT_PUBLIC_SITE_URL = โดเมนจริง เช่น https://www.chao-dee.com (ทำลิงก์เต็ม/OG/sitemap)
NEXT_PUBLIC_SITE_URL=
# ลิงก์ LINE ช่วยเหลือ (support) — เว้นว่างได้
NEXT_PUBLIC_SUPPORT_LINE_URL=
# LINE OA กลางของ Chao-Dee (override) — ค่าเริ่มต้นอยู่ในโค้ด src/lib/line-oa.ts (@epe8275f)
NEXT_PUBLIC_LINE_OA_ID=

# ===== อีเมล (Resend) — อีเมลต้อนรับ/แจ้งเตือน =====
# RESEND_API_KEY = คีย์จาก resend.com (เว้นว่าง = ไม่ส่งอีเมล)
RESEND_API_KEY=
# EMAIL_FROM = ผู้ส่ง เช่น "Chao-Dee <no-reply@chao-dee.com>"
EMAIL_FROM=
